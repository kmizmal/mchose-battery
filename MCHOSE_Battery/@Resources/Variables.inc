[Variables]
; =====================================================================
;  MCHOSE V7 电量 · 可调参数
;  改完保存，右键皮肤 → 刷新皮肤（或按 F5）生效
; =====================================================================
; ---------- 数据源 ----------
; 数据由 C# 插件 MCHOSE_Battery.dll 直接读 HID，没有外部进程、不需要 Python。
; 插件位置：Rainmeter 安装目录的 Plugins\MCHOSE_Battery.dll（安装包会自动放好）。
; 设备选择（两张卡片各用一个，Rainmeter 里是两张独立皮肤，可同时加载）：
;   auto = 先探 G87 键盘，探不到再回落 V7 鼠标
;   g87 / keyboard = 只查 G87 键盘
;   v7  / mouse    = 只查 V7 鼠标
DeviceMouse=v7
DeviceKeyboard=g87
; 采集间隔（分钟）。电量按小时变化，20 分钟一次足够；
; 代价是掉线最多要 20 分钟才发现，想及时就在卡片上左键手动刷新一次。
RefreshMinutes=20
; 单次 HID 收包窗口（毫秒）。鼠标休眠时越小越快回到「已断开」。
TimeoutMs=450
; 提示音开关：0 = 静音（默认，只做视觉提醒），1 = 开启。
; 开启后低电首次触发会响，之后每小时最多一次；掉线不重复响。
SoundOn=0
; ---------- 提醒阈值 ----------
LowBattery=20
CriticalBattery=8
; ---------- 外观 ----------
FontFace=Segoe UI
CardW=264
CardH=138
BarW=228
; 皮肤整体不透明度，0-255。203 / 255 ≈ 80%，即保留 20% 的通透感。
; 每次刷新皮肤都会重新套用这个值；想更实就调高（255 = 完全不透明）。
OpacityValue=203
; 进度条形态：细线 3px / 悬停 9px，圆角取高度的一半做成胶囊端
BarH=3
BarR=1.5
BarY=96
; 左上角产品图配色，对应官方设备卡的四色：
;   white / black / red / pink
; 改这里可直接指定；也可以直接在卡片上按鼠标中键循环切换。
Colorway=pink
; 与 Colorway 一一对应的序号，中键循环时用，不要单独改
ColorIndex=3
; 以下颜色由皮肤按状态自动改写，这里只是初始值（暗色主题）
Accent=78,160,255,255
Dot=62,214,152,255
PillFg=150,196,255,255
PillBg=32,54,88,255
; ---------- 运行时状态 ----------
; 电量、主题码等现在由 C# 插件通过 Field=xxx 的 measure 直接提供，
; 不再写入皮肤变量，因此这里不需要任何 V_* 配置。
