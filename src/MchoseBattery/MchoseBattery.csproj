<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rainmeter 插件必须导出原生符号。这里不依赖 DllExport / DllExporter.exe，
    而是编译后由 build_plugin.py 做 IL 后处理（ildasm → 注入 .export → ilasm）。

    约束：
      · 目标框架锁 .NET Framework（net48）—— .NET 5+ 的 PE 头无法被原生宿主直接 LoadLibrary
      · 平台锁 x64 —— 本机 Rainmeter.exe 的 PE Machine = 0x8664，位数不匹配会静默加载失败
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>MCHOSE_Battery</AssemblyName>
    <RootNamespace>MchoseBattery</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>MCHOSE Battery Rainmeter Plugin</Product>
    <AssemblyTitle>MCHOSE_Battery</AssemblyTitle>
    <Version>1.3.0</Version>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <!-- Finalize 是导出名，不能改名 -->
    <NoWarn>$(NoWarn);CS0465</NoWarn>
  </PropertyGroup>

  <!--
    蓝牙档连接状态判定要用 WinRT BluetoothDevice.ConnectionStatus（见 Hid\BthLink.cs）。
    引用系统自带的拆分 winmd（Win10/11 均随 OS 提供），不引 NuGet 包。
    注意别换成 GAC 的 System.Runtime.WindowsRuntime + AsTask：那份绑定 union
    Windows.winmd，与拆分 winmd 类型标识冲突（CS0012）；本项目 IL 往返后
    直接挂 Completed 回调同步等待即可。
  -->
  <ItemGroup>
    <Reference Include="Windows.Foundation">
      <HintPath>C:\Windows\System32\WinMetadata\Windows.Foundation.winmd</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Devices">
      <HintPath>C:\Windows\System32\WinMetadata\Windows.Devices.winmd</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
