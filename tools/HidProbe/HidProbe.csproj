    <Compile Include="..\..\src\MchoseBattery\Hid\MchoseProtocol.cs" Link="MchoseProtocol.cs" />
    <Compile Include="..\..\src\MchoseBattery\Hid\G87Protocol.cs" Link="G87Protocol.cs" />
    <Compile Include="..\..\src\MchoseBattery\Hid\G87Battery.cs" Link="G87Battery.cs" />
    <Compile Include="..\..\src\MchoseBattery\Hid\HidBattery.cs" Link="HidBattery.cs" />
    <Compile Include="..\..\src\MchoseBattery\Hid\BleBattery.cs" Link="BleBattery.cs" />
    <Compile Include="..\..\src\MchoseBattery\StatusModel.cs" Link="StatusModel.cs" />
  </ItemGroup>

</Project>
